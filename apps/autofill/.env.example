# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Option A (recommended): upload through the API with a per-user API key ---
# Create the key in the webapp under Settings → API keys. When EXPENSER_API_KEY is set the
# bot calls the backend directly and the browser settings below are ignored.
EXPENSER_API_URL=https://expenser-api.juanromerodev.com
EXPENSER_API_KEY=

# --- Option B: drive the webapp with Playwright, logging in with email + password ---
# Used only when EXPENSER_API_KEY is empty. (http://localhost:4321 for local dev)
EXPENSER_URL=https://expenser.juanromerodev.com
EXPENSER_EMAIL=
EXPENSER_PASSWORD=

# Folders, relative to apps/autofill unless absolute.
# Drop images in INBOX_DIR; they move to PROCESSED_DIR (with the extracted JSON) once
# added, or to FAILED_DIR (with the error) if anything goes wrong.
INBOX_DIR=./inbox
PROCESSED_DIR=./processed
FAILED_DIR=./failed

# Option B only: set to false to watch the browser fill the form
HEADLESS=true

# Option B only, optional: use an existing Chrome/Chromium instead of the one `pnpm setup` downloads
# BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
