# --- Database (libSQL) ---
# Local dev: a SQLite file, relative to apps/backend. Created (with its schema) on first start.
# Production: a Turso URL, e.g. libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL="file:./dev.db"
# Only required for remote Turso (libsql://). Leave unset for local file DBs.
# TURSO_AUTH_TOKEN=

# --- Server ---
PORT=3001
# Interface to bind. pm2 sets 127.0.0.1 in production (nginx proxies to it).
# HOST=0.0.0.0
# The API's public URL (no trailing slash): the OAuth issuer, and the base of the MCP server's URL
# Claude connects to. Defaults to http://localhost:<PORT>; in production
# https://expenser-api.juanromerodev.com.
# API_URL=http://localhost:3001
# The webapp's origin: the only one CORS allows, and where OAuth consent happens.
WEBAPP_URL=http://localhost:4321
# Set to "true" in production so session cookies require HTTPS.
SESSION_COOKIE_SECURE=false
# Cookie SameSite policy. "lax" is fine for local dev and for production
# (expenser.juanromerodev.com + expenser-api.juanromerodev.com are the same site).
# Use "none" only if the API and frontend are on different sites; requires
# SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax

# --- Logging ---
# tracing filter, e.g. "debug" or "expenser_backend=debug,info". Defaults to "info". rmcp (the MCP
# SDK) stays at "warn" unless named, e.g. "info,rmcp=info".
# RUST_LOG=info
